# ── Finance Tracker — environment variables ───────────────────────────────────
# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit it.

# MySQL
MYSQL_PASSWORD=change_me_strong_password

# Redis
REDIS_PASSWORD=change_me_strong_password

# MinIO
MINIO_ACCESS_KEY=change_me_access_key
MINIO_SECRET_KEY=change_me_secret_key_min_8_chars

# Public URL for MinIO presigned image URLs
MINIO_PUBLIC_URL=https://wisefintrakr.com

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=change_me_super_long_secret_at_least_32_characters_long

# Google OAuth client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
