<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.z.finance.tracker.mapper.UserMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (username, password, email, profile_image_url)
        VALUES (#{username}, #{password}, #{email}, #{profileImageUrl})
    </insert>

    <select id="findByUsername" resultType="com.z.finance.tracker.entity.User">
        SELECT * FROM users WHERE username = #{username}
    </select>

    <select id="findById" resultType="com.z.finance.tracker.entity.User">
        SELECT * FROM users WHERE id = #{id}
    </select>

    <update id="updateProfile">
        UPDATE users
        SET email = #{email},
        profile_image_url = #{profileImageUrl}
        WHERE id = #{id}
    </update>

    <update id="updatePassword">
        UPDATE users
        SET password = #{password}
        WHERE id = #{id}
    </update>

</mapper>